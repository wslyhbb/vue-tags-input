{
  "name": "@wslyhbb/vue3-tags-input",
  "version": "4.0.1",
  "author": "Johannes Munari <johannesm@hotmail.de>",
  "contributors": [
    {
      "name": "Sinclair Chen",
      "url": "https://github.com/sipec"
    },
    {
      "name": "Wesley Hobbie",
      "url": "https://github.com/wslyhbb"
    }
  ],
  "license": "MIT",
  "description": "A tags input component for Vue 3 with autocompletion, custom validation, templating and much more",
  "homepage": "http://www.vue-tags-input.com",
  "private": false,
  "keywords": [
    "javascript",
    "vue",
    "vue3",
    "tags",
    "vue-tags-input",
    "vue-component",
    "autocomplete"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wslyhbb/vue-tags-input.git"
  },
  "main": "dist/vue-tags-input.js",
  "module": "dist/vue-tags-input.mjs",
  "scripts": {
    "dev": "npm run generate-docs && npm run docs",
    "docs": "vite ./docs",
    "build-docs": "npm run generate-docs && vite build ./docs",
    "analyze": "cross-env VITE_VISUALIZE=true npm run build-docs",
    "generate-docs": "node --input-type=module -e \"import('./docs/docs-loader.mjs')\"",
    "build-lib": "vite build",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "e2e": "testcafe all e2e/*test* --app \"npm run dev\" --app-init-delay 10000 -S -s screenshots"
  },
  "lint-staged": {
    "*.js": "node run eslint",
    "*.vue": "node run eslint"
  },
  "files": [
    "dist/*",
    "vue-tags-input/*"
  ],
  "exports": {
    ".": {
      "import": "./dist/vue-tags-input.mjs",
      "require": "./dist/vue-tags-input.js"
    }
  },
  "peerDependencies": {
    "vue": "3.x"
  },
  "dependencies": {
    "vue": "^3.5.8"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.1",
    "@eslint/js": "^9.11.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/compiler-sfc": "^3.5.8",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.7",
    "cross-env": "^10.1.0",
    "documentation": "^14.0.3",
    "eslint": "^9.11.1",
    "eslint-plugin-vue": "^10.7.0",
    "fast-deep-equal": "^3.1.3",
    "globals": "^17.2.0",
    "husky": "^9.1.6",
    "lint-staged": "^16.2.7",
    "normalize-css": "^2.3.1",
    "postcss": "^8.4.47",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.79.3",
    "terser": "^5.46.0",
    "testcafe": "^3.0.0",
    "testcafe-vue-selectors": "^3.0.0",
    "vite": "^7.3.1",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vue-eslint-parser": "^10.2.0",
    "vue-router": "^4.0.6"
  },
  "browserslist": [
    "ie >= 11",
    "last 2 Firefox versions",
    "last 5 Chrome versions",
    "last 2 iOS versions"
  ],
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
